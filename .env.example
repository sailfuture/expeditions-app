# Copy to .env.local and fill in. Never commit .env.local.

# Generate a secret: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# Cloudinary cloud name that serves resized recipe photos (lib/recipe-image.ts). Fetch delivery
# must be enabled on that account: Settings → Security → Restricted media types → leave
# "Fetched URL" unchecked. Defaults to the SailFuture account when unset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Vercel AI Gateway key for the "Generate photo" button on recipes (app/api/generate-recipe-image).
# Create one at https://vercel.com/d?to=%2F%5Bteam%5D%2F~%2Fai-gateway%2Fapi-keys. Only needed locally:
# Vercel deployments authenticate with OIDC on their own. Optional overrides: RECIPE_IMAGE_MODEL
# (default bfl/flux-3-image) and RECIPE_IMAGE_TEXT_MODEL (default anthropic/claude-haiku-5.5).
AI_GATEWAY_API_KEY=...

# Mapbox public token (pk.*) for the expedition Route Map tab.
# Create one at https://account.mapbox.com/access-tokens/ and restrict it to
# your site's URL. Restart `npm run dev` after changing it.
NEXT_PUBLIC_MAPBOX_TOKEN=
